{
	"name": "discord-bot-framework",
	"version": "1.0.0",
	"description": "Modular Discord Bot Framework",
	"main": "src/index.ts",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"build": "bun run check:commands && tsc",
		"dev": "NODE_ENV=development bun run src/index.ts",
		"start": "NODE_ENV=production bun run src/index.ts",
		"db:migrate": "bun run src/database/migrate.ts",
		"check:commands": "bun run scripts/check-commands.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"discord.js": "^14.14.1",
		"dotenv": "^16.3.1",
		"pg": "^8.11.3",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "^20.10.0",
		"@types/pg": "^8.10.9",
		"typescript": "^5.3.2"
	}
}
