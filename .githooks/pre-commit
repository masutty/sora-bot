#!/bin/sh
# Lints/format-checks only the staged files. Enable once per clone: `bun run hooks:install`.
bunx biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true --colors=off || {
    echo ""
    echo "biome check failed - run \`bun run lint:fix\`, re-stage, and commit again."
    exit 1
}
